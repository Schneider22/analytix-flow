{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analytixflow.local/contracts/m6/output.schema.json",
  "title": "M6 Deployment Output",
  "type": "object",
  "allOf": [
    { "$ref": "../common/execution-result.schema.json" },
    {
      "type": "object",
      "required": ["module_output"],
      "properties": {
        "module_id": { "const": "m6" },
        "module_output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package_artifacts", "validation_report", "deployment_plan"],
          "properties": {
            "package_artifacts": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "../common/artifact-reference.schema.json" }
            },
            "validation_report": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "tests", "limitations"],
              "properties": {
                "status": { "type": "string", "enum": ["passed", "passed_with_warnings", "failed"] },
                "tests": { "type": "array", "items": { "type": "object" } },
                "limitations": { "type": "array", "items": { "type": "string" } }
              }
            },
            "deployment_plan": {
              "type": "object",
              "additionalProperties": false,
              "required": ["target_type", "configuration_artifact", "permissions", "rollback_plan", "cost_status", "cloud_execution_allowed"],
              "properties": {
                "target_type": { "type": "string", "enum": ["local_process", "docker_artifact", "cloud_plan_only"] },
                "configuration_artifact": { "$ref": "../common/artifact-reference.schema.json" },
                "permissions": { "type": "array", "items": { "type": "string" } },
                "rollback_plan": { "type": "string", "minLength": 1 },
                "cost_status": { "type": "string", "enum": ["known", "estimated", "not_available", "not_applicable"] },
                "cloud_execution_allowed": { "const": false },
                "approval_request": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "reason"],
                  "properties": {
                    "action": { "const": "approve_deployment_action" },
                    "reason": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
