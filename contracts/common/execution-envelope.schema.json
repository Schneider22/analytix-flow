{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analytixflow.local/contracts/common/execution-envelope.schema.json",
  "title": "Execution Envelope",
  "description": "Common input envelope for every AnalytixFlow module.",
  "type": "object",
  "required": ["project_id", "execution_id", "module_id", "contract_version", "context_snapshot_id", "correlation_id", "status", "idempotency_key"],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "module_id": {
      "type": "string",
      "enum": ["m1", "m2", "m3", "m4", "m5", "m6", "m7", "m8"]
    },
    "contract_version": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "context_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "artifact-reference.schema.json"
      },
      "uniqueItems": true
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "$ref": "approval-reference.schema.json"
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": ["requested", "ready", "running", "awaiting_approval", "succeeded", "rejected", "failed_retryable", "failed_terminal", "superseded"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "module-error.schema.json"
      }
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
