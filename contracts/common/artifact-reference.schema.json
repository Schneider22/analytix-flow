{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analytixflow.local/contracts/common/artifact-reference.schema.json",
  "title": "Artifact Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_type", "artifact_version", "content_hash"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_type": {
      "type": "string",
      "minLength": 1
    },
    "artifact_version": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "uri": {
      "type": "string",
      "minLength": 1
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "layer": {
      "type": "string",
      "enum": ["source", "bronze", "silver", "gold", "model", "report", "deployment", "audit", "other"]
    },
    "produced_by_module": {
      "type": "string",
      "enum": ["m1", "m2", "m3", "m4", "m5", "m6", "m7", "m8", "system", "user"]
    },
    "parent_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
