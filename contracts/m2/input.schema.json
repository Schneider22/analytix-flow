{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://analytixflow.local/contracts/m2/input.schema.json",
  "title": "M2 Ingestion Input",
  "type": "object",
  "allOf": [
    { "$ref": "../common/execution-envelope.schema.json" },
    {
      "type": "object",
      "required": ["module_input"],
      "properties": {
        "module_id": { "const": "m2" },
        "module_input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected_alternative_id", "source_artifacts", "ingestion_options"],
          "properties": {
            "selected_alternative_id": { "type": "string", "minLength": 1 },
            "source_artifacts": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "../common/artifact-reference.schema.json" }
            },
            "ingestion_options": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["artifact_id", "format"],
                "properties": {
                  "artifact_id": { "type": "string", "minLength": 1 },
                  "format": { "type": "string", "enum": ["csv", "xlsx", "xls"] },
                  "encoding": { "type": "string" },
                  "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
                  "sheet_name": { "type": "string" },
                  "header_row": { "type": "integer", "minimum": 0 },
                  "date_interpretation": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
