# Local development example only. Do not use real credentials or commit .env.
APP_ENV=development
POSTGRES_DB=analytixflow
POSTGRES_USER=analytixflow
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://analytixflow:change-me-local-only@db:5432/analytixflow
ARTIFACT_STORE_PATH=./.local/artifacts
MAX_ARTIFACT_BYTES=52428800
MAX_METADATA_BYTES=262144
MAX_CORRELATION_ID_LENGTH=128
